{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aikagi-ban",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "aikagi-ban.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["53 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aikagi-ban",
      "database_id": "14df2bbd-d291-4a8c-b3d5-011491706afa",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "aikagi-ban-photos",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
